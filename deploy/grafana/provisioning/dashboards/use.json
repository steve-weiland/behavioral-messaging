{
  "annotations": {"list": []},
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [
    {
      "title": "Back to RED + Drops",
      "type": "dashboards",
      "tags": ["red"],
      "asDropdown": false,
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "RabbitMQ — U/S/E",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "collapsed": false
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "U — connections + channels",
      "description": "Utilisation: how many client connections + channels the broker is currently handling. From rabbitmq_prometheus.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "rabbitmq_connections", "legendFormat": "connections"},
        {"refId": "B", "expr": "rabbitmq_channels",    "legendFormat": "channels"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}},
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 1}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "S — total queue depth",
      "description": "Saturation: messages waiting across all queues. A climbing line means producers outpace consumers.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "sum(rabbitmq_detailed_queue_messages)", "legendFormat": "all queues"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}},
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 1}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "E — disk-free + memory headroom",
      "description": "Errors-imminent: when these dip toward 0 the broker enters flow-control and producers stall.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "rabbitmq_disk_space_available_bytes", "legendFormat": "disk available"},
        {"refId": "B", "expr": "rabbitmq_resident_memory_limit_bytes - rabbitmq_process_resident_memory_bytes", "legendFormat": "memory headroom"}
      ],
      "fieldConfig": {"defaults": {"unit": "decbytes", "min": 0}},
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 1}
    },

    {
      "id": 5,
      "type": "row",
      "title": "MySQL — U/S/E",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 8},
      "collapsed": false
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "U — connected threads",
      "description": "Utilisation: client threads currently connected to the MySQL server. Direct analog of Postgres's pg_stat_database.numbackends. From OTel mysqlreceiver (mysql_threads{kind=\"connected\"}).",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "mysql_threads{kind=\"connected\"}", "legendFormat": "connected"},
        {"refId": "B", "expr": "mysql_threads{kind=\"running\"}",   "legendFormat": "running"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}},
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 9}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "S — InnoDB buffer-pool disk reads/sec",
      "description": "Saturation proxy: actual disk reads from the InnoDB buffer pool. A spike means the working set has outgrown buffer-pool RAM and we're paying for cache misses. read_requests is the logical read rate; reads is the subset that missed cache.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "rate(mysql_buffer_pool_operations_total{operation=\"reads\"}[5m])",         "legendFormat": "disk reads"},
        {"refId": "B", "expr": "rate(mysql_buffer_pool_operations_total{operation=\"read_requests\"}[5m])", "legendFormat": "logical reads"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops", "min": 0}},
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 9}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "E — row-lock + table-lock waits/sec",
      "description": "Errors: lock contention. Zero on healthy single-writer demo workloads. Non-zero means concurrent transactions are blocking on InnoDB row locks (row_locks{kind=\"waits\"}) or MyISAM table locks (locks{kind=\"waited\"}). V2's RabbitMQ-mediated fan-out distributes writes; expect this panel to wake up under V2 soak load.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "rate(mysql_row_locks_total{kind=\"waits\"}[5m])", "legendFormat": "row-lock waits"},
        {"refId": "B", "expr": "rate(mysql_locks_total{kind=\"waited\"}[5m])",   "legendFormat": "table-lock waits"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops", "min": 0}},
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 9}
    },

    {
      "id": 9,
      "type": "row",
      "title": "Host (Linux VM under Docker Desktop)",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 16},
      "collapsed": false
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "U — CPU utilisation by mode",
      "description": "Utilisation, computed from rate(system_cpu_time_seconds_total) since the OTel receiver emits cumulative CPU-time, not a pre-computed utilisation gauge. Reads /hostfs/proc — the Linux VM Docker Desktop runs, not the macOS host. Useful relative trends only.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "avg by (state) (rate(system_cpu_time_seconds_total[1m]))", "legendFormat": "{{state}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}},
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 17}
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "S — load average (1m / 5m / 15m)",
      "description": "Saturation: tasks runnable+uninterruptible vs. cores. Sustained load > nproc means CPU-saturated.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "system_cpu_load_average_1m",  "legendFormat": "1m"},
        {"refId": "B", "expr": "system_cpu_load_average_5m",  "legendFormat": "5m"},
        {"refId": "C", "expr": "system_cpu_load_average_15m", "legendFormat": "15m"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}},
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 17}
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "E — memory used vs. cached",
      "description": "Errors-imminent (memory pressure proxy). When 'used' climbs and 'cached' stays flat, the working set is real; if cached collapses you've got pressure.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "sum by (state) (system_memory_usage_bytes)", "legendFormat": "{{state}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "decbytes", "min": 0}},
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 17}
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "tags": ["use", "obs-stack"],
  "templating": {"list": []},
  "time": {"from": "now-15m", "to": "now"},
